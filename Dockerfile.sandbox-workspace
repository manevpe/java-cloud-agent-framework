# syntax=docker/dockerfile:1

# Image for the per-workspace Kubernetes Pod that KubernetesSandboxWorkspaceClient
# creates (see agentic.sandbox.workspace-image, SandboxProperties, ADR-0006,
# and ADR-0008). PlanningAgent's exploration tools (WorkspaceSetupTool,
# FileReadTool) and CodingAgent's edit/build/test tools (FileEditTool) all
# `exec` into a running instance of this image to clone, browse, edit, and
# build/test a repository, so it ships:
#   - git, coreutils, findutils, grep, sed, gawk — clone/list/read/search/edit
#   - Java (Eclipse Temurin JDK 25 LTS — same distribution and version the
#     app's own Dockerfile uses) — repos bring their own gradlew/mvnw; this
#     just needs a JDK on PATH
#   - Node.js 24 LTS + npm — for `npm install`/`npm test`/etc.
#   - Go — for `go build`/`go test`/etc.
#   - Python 3 + pip/venv — for `pip install`/`pytest`/etc.
#   - Docker CLI — talks to the Docker-in-Docker sidecar the pod gets when
#     `agentic.sandbox.docker-in-docker-enabled=true` (see
#     KubernetesSandboxWorkspaceClient#buildWorkspacePod and
#     SandboxProperties), reachable via DOCKER_HOST=tcp://localhost:2375,
#     so repositories whose tests use Testcontainers work inside the sandbox
#   - a long-running no-op entrypoint (the Pod is kept alive purely to be
#     `exec`'d into; see KubernetesSandboxWorkspaceClient#open)
#
# Each toolchain is copied in from its own official image rather than
# installed via apt/tarball scripting, so upgrading one (bumping a FROM tag
# below) doesn't require reworking install logic for the others.
#
# This covers the toolchains this project itself expects to work with out
# of the box. For anything else (Rust, .NET, ...), build a derived image
# (`FROM ghcr.io/manevpe/agentic-sandbox-workspace:latest`) that layers on
# the extra toolchain and point `agentic.sandbox.workspace-image` at that
# derived image instead.

FROM eclipse-temurin:25-jdk-noble AS java
FROM node:24-bookworm-slim AS node
FROM golang:1.23-bookworm AS go
FROM docker:27-cli AS docker-cli

FROM debian:12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        grep \
        sed \
        gawk \
        findutils \
        coreutils \
        ca-certificates \
        curl \
        maven \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Java (Eclipse Temurin 25 LTS)
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Node.js
COPY --from=node /usr/local/bin /usr/local/bin
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=node /usr/local/include/node /usr/local/include/node

# Go
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

# Docker CLI (talks to the Docker-in-Docker sidecar; the daemon itself
# lives in that sidecar container, not here)
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

RUN groupadd --gid 1001 sandbox \
    && useradd --uid 1001 --gid sandbox --shell /bin/bash --create-home sandbox

# Go's module/build caches need a writable HOME for the sandbox user.
ENV GOPATH=/home/sandbox/go
RUN mkdir -p "${GOPATH}" && chown -R sandbox:sandbox /home/sandbox

USER sandbox:sandbox
WORKDIR /workspace

# No process actually needs to run — the pod just needs to stay Ready so
# KubernetesSandboxWorkspaceClient can `exec` git/find/cat/grep/sed/awk and
# build/test commands (./gradlew, mvn, npm, go, pytest) against it.
ENTRYPOINT ["sleep", "infinity"]
